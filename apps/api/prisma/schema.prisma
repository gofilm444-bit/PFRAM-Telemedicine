generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                       String                    @id @default(uuid()) @db.Uuid
  publicId                                                 String                    @unique @default(uuid()) @db.Uuid
  phoneNumber                                              String                    @unique
  passwordHash                                             String
  role                                                     UserRole
  status                                                   UserStatus                @default(ACTIVE)
  phoneVerifiedAt                                          DateTime?
  failedLoginCount                                         Int                       @default(0)
  lockedUntil                                              DateTime?
  lastLoginAt                                              DateTime?
  createdAt                                                DateTime                  @default(now())
  updatedAt                                                DateTime                  @updatedAt
  deactivatedAt                                            DateTime?
  adminProfile                                             AdminProfile?
  ancSchedules                                             AncSchedule[]
  auditLogs                                                AuditLog[]
  consultationMessages                                      ConsultationMessage[]
  DangerScreening_DangerScreening_createdByUserIdToUser    DangerScreening[]         @relation("DangerScreening_createdByUserIdToUser")
  DangerScreening_DangerScreening_followedUpByUserIdToUser DangerScreening[]         @relation("DangerScreening_followedUpByUserIdToUser")
  homeVisitSchedules                                        HomeVisitSchedule[]
  midwifeProfile                                           MidwifeProfile?
  monitoringEntriesCreated                                 MonitoringEntry[]         @relation("MonitoringCreator")
  assignmentsCreated                                       MotherMidwifeAssignment[] @relation("AssignmentCreator")
  motherProfile                                            MotherProfile?
  refreshSessions                                          RefreshSession[]
  consents                                                 UserConsent[]
  videoConsultations                                        VideoConsultation[]

  @@index([role, status])
  @@index([lockedUntil])
}

model Region {
  id                 String                    @id @default(uuid()) @db.Uuid
  publicId           String                    @unique @default(uuid()) @db.Uuid
  code               String?
  name               String
  level              RegionLevel
  parentId           String?                   @db.Uuid
  active             Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  archivedAt         DateTime?
  districtFacilities HealthFacility[]          @relation("FacilityDistrict")
  provinceFacilities HealthFacility[]          @relation("FacilityProvince")
  regencyFacilities  HealthFacility[]          @relation("FacilityRegency")
  villageFacilities  HealthFacility[]          @relation("FacilityVillage")
  midwifeAssignments MidwifeRegionAssignment[]
  districtMothers    MotherProfile[]           @relation("MotherDistrict")
  provinceMothers    MotherProfile[]           @relation("MotherProvince")
  regencyMothers     MotherProfile[]           @relation("MotherRegency")
  villageMothers     MotherProfile[]           @relation("MotherVillage")
  parent             Region?                   @relation("RegionHierarchy", fields: [parentId], references: [id])
  children           Region[]                  @relation("RegionHierarchy")

  @@unique([parentId, level, name])
  @@index([level, active, name])
  @@index([parentId, active])
}

model HealthFacility {
  id                                                              String                      @id @default(uuid()) @db.Uuid
  publicId                                                        String                      @unique @default(uuid()) @db.Uuid
  name                                                            String
  type                                                            HealthFacilityType
  address                                                         String
  provinceId                                                      String                      @db.Uuid
  regencyId                                                       String                      @db.Uuid
  districtId                                                      String                      @db.Uuid
  villageId                                                       String?                     @db.Uuid
  phoneNumber                                                     String?
  whatsappNumber                                                  String?
  emergencyPhone                                                  String?
  openingHours                                                    Json?
  latitude                                                        Decimal?                    @db.Decimal(10, 7)
  longitude                                                       Decimal?                    @db.Decimal(10, 7)
  serviceInformation                                              String?
  active                                                          Boolean                     @default(true)
  createdAt                                                       DateTime                    @default(now())
  updatedAt                                                       DateTime                    @updatedAt
  archivedAt                                                      DateTime?
  ancSchedules                                                    AncSchedule[]
  district                                                        Region                      @relation("FacilityDistrict", fields: [districtId], references: [id])
  province                                                        Region                      @relation("FacilityProvince", fields: [provinceId], references: [id])
  regency                                                         Region                      @relation("FacilityRegency", fields: [regencyId], references: [id])
  village                                                         Region?                     @relation("FacilityVillage", fields: [villageId], references: [id])
  midwifeAssignments                                              MidwifeFacilityAssignment[]
  primaryMidwives                                                 MidwifeProfile[]            @relation("PrimaryFacility")
  motherAssignments                                               MotherMidwifeAssignment[]
  mothers                                                         MotherProfile[]
  p4kPlans                                                        P4kPlan[]
  destinationReferralPlans                                        ReferralPlan[]              @relation("ReferralPlan_destinationFacilityIdToHealthFacility")
  sourceReferralPlans                                             ReferralPlan[]              @relation("ReferralPlan_sourceFacilityIdToHealthFacility")

  @@index([active, type, name])
  @@index([provinceId, regencyId, districtId])
}

model MotherProfile {
  id                           String                    @id @default(uuid()) @db.Uuid
  userId                       String                    @unique @db.Uuid
  fullName                     String
  preferredName                String?
  dateOfBirth                  DateTime?                 @db.Date
  profileCompleted             Boolean                   @default(false)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  address                      String?
  completedAt                  DateTime?
  districtId                   String?                   @db.Uuid
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  familyContactName            String?
  familyContactPhone           String?
  primaryFacilityId            String?                   @db.Uuid
  provinceId                   String?                   @db.Uuid
  publicId                     String                    @unique @default(uuid()) @db.Uuid
  regencyId                    String?                   @db.Uuid
  villageId                    String?                   @db.Uuid
  ancSchedules                 AncSchedule[]
  consultationThreads          ConsultationThread[]
  dangerScreenings             DangerScreening[]
  homeVisitSchedules           HomeVisitSchedule[]
  monitoringEntries            MonitoringEntry[]
  midwifeAssignments           MotherMidwifeAssignment[]
  district                     Region?                   @relation("MotherDistrict", fields: [districtId], references: [id])
  primaryFacility              HealthFacility?           @relation(fields: [primaryFacilityId], references: [id])
  province                     Region?                   @relation("MotherProvince", fields: [provinceId], references: [id])
  regency                      Region?                   @relation("MotherRegency", fields: [regencyId], references: [id])
  user                         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  village                      Region?                   @relation("MotherVillage", fields: [villageId], references: [id])
  reminderSettings             MotherReminderSettings?
  p4kPlans                     P4kPlan[]
  pregnancies                  Pregnancy[]
  referralPlans                ReferralPlan[]
  reminders                    Reminder[]
  videoConsultations           VideoConsultation[]

  @@index([profileCompleted])
  @@index([primaryFacilityId])
}

model MidwifeProfile {
  id                             String                      @id @default(uuid()) @db.Uuid
  userId                         String                      @unique @db.Uuid
  fullName                       String
  phoneNumber                    String
  active                         Boolean                     @default(true)
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  archivedAt                     DateTime?
  position                       String?
  preferredName                  String?
  primaryFacilityId              String?                     @db.Uuid
  professionalRegistrationNumber String?
  profileCompleted               Boolean                     @default(false)
  publicId                       String                      @unique @default(uuid()) @db.Uuid
  serviceHours                   Json?
  whatsappNumber                 String?
  serviceStartTime               String?                     @default("08:00")
  serviceEndTime                 String?                     @default("16:00")
  estimatedResponseMinutes       Int?                        @default(60)
  consultationThreads            ConsultationThread[]
  homeVisitSchedules             HomeVisitSchedule[]
  facilityAssignments            MidwifeFacilityAssignment[]
  primaryFacility                HealthFacility?             @relation("PrimaryFacility", fields: [primaryFacilityId], references: [id])
  user                           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  regionAssignments              MidwifeRegionAssignment[]
  motherAssignments              MotherMidwifeAssignment[]
  videoConsultations             VideoConsultation[]

  @@index([active])
  @@index([primaryFacilityId])
}

model MidwifeFacilityAssignment {
  id         String         @id @default(uuid()) @db.Uuid
  publicId   String         @unique @default(uuid()) @db.Uuid
  midwifeId  String         @db.Uuid
  facilityId String         @db.Uuid
  primary    Boolean        @default(false)
  active     Boolean        @default(true)
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  facility   HealthFacility @relation(fields: [facilityId], references: [id])
  midwife    MidwifeProfile @relation(fields: [midwifeId], references: [id])

  @@index([midwifeId, active])
  @@index([facilityId, active])
}

model MidwifeRegionAssignment {
  id        String         @id @default(uuid()) @db.Uuid
  publicId  String         @unique @default(uuid()) @db.Uuid
  midwifeId String         @db.Uuid
  regionId  String         @db.Uuid
  active    Boolean        @default(true)
  startedAt DateTime       @default(now())
  endedAt   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  midwife   MidwifeProfile @relation(fields: [midwifeId], references: [id])
  region    Region         @relation(fields: [regionId], references: [id])

  @@index([midwifeId, active])
  @@index([regionId, active])
}

model Pregnancy {
  id                         String                    @id @default(uuid()) @db.Uuid
  publicId                   String                    @unique @default(uuid()) @db.Uuid
  motherId                   String                    @db.Uuid
  pregnancyNumber            Int
  lastMenstrualPeriod        DateTime?                 @db.Date
  estimatedDueDate           DateTime                  @db.Date
  gestationalAgeSource       GestationalAgeSource
  assessmentDate             DateTime?                 @db.Date
  initialGestationalAgeWeeks Int?
  initialGestationalAgeDays  Int?
  pregnancyType              PregnancyType             @default(UNKNOWN)
  previousPregnancyCount     Int                       @default(0)
  previousDeliveryCount      Int                       @default(0)
  miscarriageCount           Int                       @default(0)
  previousCesarean           Boolean                   @default(false)
  hypertensionHistory        Boolean                   @default(false)
  preeclampsiaHistory        Boolean                   @default(false)
  diabetesHistory            Boolean                   @default(false)
  heartDiseaseHistory        Boolean                   @default(false)
  kidneyDiseaseHistory       Boolean                   @default(false)
  otherDiseaseHistory        String?
  additionalNotes            String?
  status                     PregnancyStatus           @default(ACTIVE)
  startedAt                  DateTime                  @default(now())
  endedAt                    DateTime?
  outcome                    String?
  completedProfile           Boolean                   @default(false)
  dueDateCorrectionReason    String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  ancSchedules               AncSchedule[]
  consultationThreads        ConsultationThread[]
  dangerScreenings           DangerScreening[]
  homeVisitSchedules         HomeVisitSchedule[]
  monitoringEntries          MonitoringEntry[]
  assignments                MotherMidwifeAssignment[]
  p4kPlan                    P4kPlan?
  mother                     MotherProfile             @relation(fields: [motherId], references: [id])
  referralPlan               ReferralPlan?
  reminders                  Reminder[]
  videoConsultations        VideoConsultation[]

  @@unique([motherId, pregnancyNumber])
  @@index([motherId, status])
}

model MotherMidwifeAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  publicId          String           @unique @default(uuid()) @db.Uuid
  motherId          String           @db.Uuid
  pregnancyId       String           @db.Uuid
  midwifeId         String           @db.Uuid
  facilityId        String           @db.Uuid
  status            AssignmentStatus @default(ACTIVE)
  startedAt         DateTime         @default(now())
  endedAt           DateTime?
  assignedByUserId  String           @db.Uuid
  replacementReason String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedBy        User             @relation("AssignmentCreator", fields: [assignedByUserId], references: [id])
  facility          HealthFacility   @relation(fields: [facilityId], references: [id])
  midwife           MidwifeProfile   @relation(fields: [midwifeId], references: [id])
  mother            MotherProfile    @relation(fields: [motherId], references: [id])
  pregnancy         Pregnancy        @relation(fields: [pregnancyId], references: [id])

  @@index([motherId, pregnancyId, status])
  @@index([midwifeId, status])
  @@index([facilityId, status])
}

model AdminProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceName String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model ConsentDocument {
  id           String        @id @default(uuid()) @db.Uuid
  documentType String
  version      String
  title        String
  content      String
  active       Boolean       @default(false)
  effectiveAt  DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  consents     UserConsent[]

  @@unique([documentType, version])
  @@index([active, effectiveAt])
}

model UserConsent {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  documentId  String          @db.Uuid
  agreedAt    DateTime        @default(now())
  withdrawnAt DateTime?
  createdAt   DateTime        @default(now())
  document    ConsentDocument @relation(fields: [documentId], references: [id])
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @db.Uuid
  actorRole   UserRole?
  action      String
  entityType  String?
  entityId    String?
  result      String
  requestId   String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, result])
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model MonitoringEntry {
  id              String           @id @default(uuid()) @db.Uuid
  publicId        String           @unique @default(uuid()) @db.Uuid
  motherId        String           @db.Uuid
  pregnancyId     String           @db.Uuid
  recordedAt      DateTime
  source          MonitoringSource
  weightKg        Decimal?         @db.Decimal(5, 2)
  systolicBp      Int?
  diastolicBp     Int?
  notes           String?
  createdByUserId String           @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  createdBy       User             @relation("MonitoringCreator", fields: [createdByUserId], references: [id])
  mother          MotherProfile    @relation(fields: [motherId], references: [id])
  pregnancy       Pregnancy        @relation(fields: [pregnancyId], references: [id])

  @@index([motherId, archivedAt, recordedAt])
  @@index([pregnancyId, archivedAt, recordedAt])
  @@index([createdByUserId])
}

model AncRuleSet {
  id                    String   @id @default(uuid()) @db.Uuid
  publicId              String   @unique @default(uuid()) @db.Uuid
  version               String   @unique
  active                Boolean  @default(true)
  effectiveFrom         DateTime @default(now())
  minimumVisits         Int      @default(6)
  minimumDoctorVisits   Int      @default(2)
  trimesterDistribution Json
  sourceReference       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([active, effectiveFrom])
}

model AncSchedule {
  id                 String          @id @default(uuid()) @db.Uuid
  publicId           String          @unique @default(uuid()) @db.Uuid
  motherId           String          @db.Uuid
  pregnancyId        String          @db.Uuid
  facilityId         String?         @db.Uuid
  scheduledAt        DateTime
  visitType          AncVisitType    @default(ANC)
  doctorRequired     Boolean         @default(false)
  status             AncVisitStatus  @default(SCHEDULED)
  notes              String?
  completedAt        DateTime?
  createdByUserId    String          @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  archivedAt         DateTime?
  cancellationReason String?
  createdBy          User            @relation(fields: [createdByUserId], references: [id])
  facility           HealthFacility? @relation(fields: [facilityId], references: [id])
  mother             MotherProfile   @relation(fields: [motherId], references: [id])
  pregnancy          Pregnancy       @relation(fields: [pregnancyId], references: [id])
  reminders          Reminder[]

  @@index([createdByUserId])
  @@index([motherId, status, scheduledAt])
  @@index([pregnancyId, status])
  @@index([scheduledAt])
}

model ConsultationAttachment {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId            String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId           String                  @db.Uuid
  fileType            ConsultationMessageType
  originalFilename    String
  mimeType            String
  fileSizeBytes       Int
  storageKey          String
  durationSeconds     Int?
  createdAt           DateTime                @default(now())
  message             ConsultationMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ConsultationMessage {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId               String                   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  threadId               String                   @db.Uuid
  senderRole             ConsultationSenderRole
  senderUserId           String                   @db.Uuid
  messageType            ConsultationMessageType  @default(TEXT)
  body                   String?
  readAt                 DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  archivedAt             DateTime?
  attachments            ConsultationAttachment[]
  sender                 User                     @relation(fields: [senderUserId], references: [id])
  thread                 ConsultationThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, readAt])
}

model ConsultationThread {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId            String                    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  motherId            String                    @db.Uuid
  midwifeId           String                    @db.Uuid
  pregnancyId         String                    @db.Uuid
  status              ConsultationThreadStatus  @default(OPEN)
  attentionFlag       ConsultationAttentionFlag @default(NORMAL)
  lastMessageAt       DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  archivedAt          DateTime?
  messages            ConsultationMessage[]
  midwife             MidwifeProfile            @relation(fields: [midwifeId], references: [id])
  mother              MotherProfile             @relation(fields: [motherId], references: [id])
  pregnancy           Pregnancy                 @relation(fields: [pregnancyId], references: [id])
  videoConsultations  VideoConsultation[]

  @@index([midwifeId, status, attentionFlag])
  @@index([motherId, status])
  @@index([pregnancyId])
}

model DangerScreening {
  id                                            String                    @id @default(uuid()) @db.Uuid
  publicId                                      String                    @unique @default(uuid()) @db.Uuid
  motherId                                      String                    @db.Uuid
  pregnancyId                                   String                    @db.Uuid
  ruleSetVersion                                String
  screenedAt                                    DateTime                  @default(now())
  status                                        DangerScreeningStatus     @default(NO_DANGER_REPORTED)
  reportedSignsCount                            Int                       @default(0)
  summary                                       String?
  followUpStatus                                DangerFollowUpStatus      @default(PENDING)
  followUpNotes                                 String?
  followUpUpdatedAt                             DateTime?
  followedUpByUserId                            String?                   @db.Uuid
  createdByUserId                               String                    @db.Uuid
  createdAt                                     DateTime                  @default(now())
  updatedAt                                     DateTime                  @updatedAt
  archivedAt                                    DateTime?
  createdBy                                     User                      @relation("DangerScreening_createdByUserIdToUser", fields: [createdByUserId], references: [id])
  followedUpBy                                  User?                     @relation("DangerScreening_followedUpByUserIdToUser", fields: [followedUpByUserId], references: [id])
  mother                                        MotherProfile             @relation(fields: [motherId], references: [id])
  pregnancy                                     Pregnancy                 @relation(fields: [pregnancyId], references: [id])
  responses                                     DangerScreeningResponse[]

  @@index([followUpStatus, status])
  @@index([motherId, archivedAt, screenedAt])
  @@index([pregnancyId, status])
}

model DangerScreeningResponse {
  id               String          @id @default(uuid()) @db.Uuid
  screeningId      String          @db.Uuid
  ruleCode         String
  title            String
  question         String
  answer           Boolean
  severityCategory String
  createdAt        DateTime        @default(now())
  screening        DangerScreening @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@unique([screeningId, ruleCode])
  @@index([screeningId, answer])
}

model DangerSignRule {
  id                     String            @id @default(uuid()) @db.Uuid
  publicId               String            @unique @default(uuid()) @db.Uuid
  ruleSetId              String            @db.Uuid
  code                   String
  title                  String
  description            String?
  trimesterApplicability Json
  question               String
  severityCategory       String
  sortOrder              Int               @default(0)
  active                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  ruleSet                DangerSignRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@unique([ruleSetId, code])
  @@index([ruleSetId, active, sortOrder])
}

model DangerSignRuleSet {
  id              String           @id @default(uuid()) @db.Uuid
  publicId        String           @unique @default(uuid()) @db.Uuid
  version         String           @unique
  name            String
  sourceReference String
  effectiveFrom   DateTime         @default(now())
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rules           DangerSignRule[]

  @@index([active, effectiveFrom])
}

model EducationArticle {
  id              String             @id @default(uuid()) @db.Uuid
  publicId        String             @unique @default(uuid()) @db.Uuid
  slug            String             @unique
  title           String
  summary         String
  content         String
  category        EducationCategory
  trimester       EducationTrimester @default(ALL)
  featured        Boolean            @default(false)
  sourceName      String
  sourceReference String?
  published       Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archivedAt      DateTime?

  @@index([category, published])
  @@index([featured, published])
  @@index([published, archivedAt, trimester])
  @@index([slug])
}

model HomeVisitSchedule {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId        String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  motherId        String          @db.Uuid
  midwifeId       String          @db.Uuid
  pregnancyId     String?         @db.Uuid
  scheduledAt     DateTime
  purpose         String
  notes           String?
  status          HomeVisitStatus @default(SCHEDULED)
  completedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdByUserId String          @db.Uuid
  createdBy       User            @relation(fields: [createdByUserId], references: [id])
  midwife         MidwifeProfile  @relation(fields: [midwifeId], references: [id])
  mother          MotherProfile   @relation(fields: [motherId], references: [id])
  pregnancy       Pregnancy?      @relation(fields: [pregnancyId], references: [id])

  @@index([midwifeId, scheduledAt, status])
  @@index([motherId, scheduledAt])
  @@index([pregnancyId, status])
}

model MotherReminderSettings {
  id                    String        @id @default(uuid()) @db.Uuid
  publicId              String        @unique @default(uuid()) @db.Uuid
  motherId              String        @unique @db.Uuid
  ironTabletEnabled     Boolean       @default(true)
  ironTabletTime        String        @default("20:00")
  ancReminderEnabled    Boolean       @default(true)
  ancReminderDaysBefore Int           @default(1)
  ancReminderTime       String        @default("08:00")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  mother                MotherProfile @relation(fields: [motherId], references: [id])
}

model P4kChecklistItem {
  id        String    @id @default(uuid()) @db.Uuid
  publicId  String    @unique @default(uuid()) @db.Uuid
  p4kPlanId String    @db.Uuid
  itemKey   String
  title     String
  category  String
  checked   Boolean   @default(false)
  checkedAt DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  p4kPlan   P4kPlan   @relation(fields: [p4kPlanId], references: [id], onDelete: Cascade)

  @@unique([p4kPlanId, itemKey])
  @@index([p4kPlanId, sortOrder])
}

model P4kPlan {
  id                         String             @id @default(uuid()) @db.Uuid
  publicId                   String             @unique @default(uuid()) @db.Uuid
  motherId                   String             @db.Uuid
  pregnancyId                String             @unique @db.Uuid
  deliveryFacilityId         String?            @db.Uuid
  customDeliveryFacilityName String?
  deliveryAttendant          String             @default("BIDAN")
  birthCompanionName         String?
  birthCompanionPhone        String?
  transportation             String?
  fundingSource              String?
  bpjsNumber                 String?
  bloodDonors                Json?
  emergencyContactName       String?
  emergencyContactPhone      String?
  preparationNotes           String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  archivedAt                 DateTime?
  checklistItems             P4kChecklistItem[]
  deliveryFacility           HealthFacility?    @relation(fields: [deliveryFacilityId], references: [id])
  mother                     MotherProfile      @relation(fields: [motherId], references: [id])
  pregnancy                  Pregnancy          @relation(fields: [pregnancyId], references: [id])

  @@index([motherId, pregnancyId])
}

model ReferralPlan {
  id                                                                String          @id @default(uuid()) @db.Uuid
  publicId                                                          String          @unique @default(uuid()) @db.Uuid
  motherId                                                          String          @db.Uuid
  pregnancyId                                                       String          @unique @db.Uuid
  sourceFacilityId                                                  String?         @db.Uuid
  customSourceFacilityName                                          String?
  destinationFacilityId                                             String?         @db.Uuid
  customDestinationFacilityName                                     String?
  transportType                                                     String          @default("AMBULANCE")
  transportOperatorName                                             String?
  transportContactNumber                                            String?
  estimatedTravelTimeMinutes                                        Int?
  manualDepartureSchedule                                           String?
  departurePoint                                                    String?
  companions                                                        String?
  rtkName                                                           String?
  rtkAddress                                                        String?
  rtkPhone                                                          String?
  alternativeNotes                                                  String?
  createdAt                                                         DateTime        @default(now())
  updatedAt                                                         DateTime        @updatedAt
  archivedAt                                                        DateTime?
  destinationFacility                                               HealthFacility? @relation("ReferralPlan_destinationFacilityIdToHealthFacility", fields: [destinationFacilityId], references: [id])
  mother                                                            MotherProfile   @relation(fields: [motherId], references: [id])
  pregnancy                                                         Pregnancy       @relation(fields: [pregnancyId], references: [id])
  sourceFacility                                                    HealthFacility? @relation("ReferralPlan_sourceFacilityIdToHealthFacility", fields: [sourceFacilityId], references: [id])

  @@index([motherId, pregnancyId])
}

model Reminder {
  id            String         @id @default(uuid()) @db.Uuid
  publicId      String         @unique @default(uuid()) @db.Uuid
  motherId      String         @db.Uuid
  pregnancyId   String?        @db.Uuid
  ancScheduleId String?        @db.Uuid
  type          ReminderType
  scheduledAt   DateTime
  reminderTime  String         @default("20:00")
  status        ReminderStatus @default(PENDING)
  snoozedUntil  DateTime?
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  snoozeCount   Int            @default(0)
  ancSchedule   AncSchedule?   @relation(fields: [ancScheduleId], references: [id])
  mother        MotherProfile  @relation(fields: [motherId], references: [id])
  pregnancy     Pregnancy?     @relation(fields: [pregnancyId], references: [id])

  @@index([motherId, scheduledAt, status])
  @@index([type, status, scheduledAt])
}

model VideoConsultation {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId             String                  @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  motherId             String                  @db.Uuid
  midwifeId            String                  @db.Uuid
  pregnancyId          String                  @db.Uuid
  consultationThreadId String?                 @db.Uuid
  scheduledAt          DateTime
  meetingUrl           String
  title                String
  notes                String?
  status               VideoConsultationStatus @default(SCHEDULED)
  createdByUserId      String                  @db.Uuid
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  completedAt          DateTime?
  cancelledAt          DateTime?
  archivedAt           DateTime?
  consultationThread   ConsultationThread?     @relation(fields: [consultationThreadId], references: [id])
  createdBy            User                    @relation(fields: [createdByUserId], references: [id])
  midwife              MidwifeProfile          @relation(fields: [midwifeId], references: [id])
  mother               MotherProfile           @relation(fields: [motherId], references: [id])
  pregnancy            Pregnancy               @relation(fields: [pregnancyId], references: [id])

  @@index([consultationThreadId])
  @@index([midwifeId, status, scheduledAt])
  @@index([motherId, status, scheduledAt])
}

