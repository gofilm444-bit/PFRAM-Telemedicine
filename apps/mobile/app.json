{
  "expo": {
    "name": "PFRAM Telemedicine",
    "slug": "pfram-telemedicine",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pfram",
    "userInterfaceStyle": "light",
    "android": {
      "package": "id.pfram.telemedicine",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F2"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Aplikasi PFRAM membutuhkan akses mikrofon untuk merekam pesan suara telekonsultasi.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7fd6acfe-1588-45e6-b6b3-30de36135322"
      }
    },
    "owner": "junaedi89"
  }
}
